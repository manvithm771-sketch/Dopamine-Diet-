<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- App-level override: the unified product is dark from the first frame,
         including startup and Android system bars. -->
    <style name="Theme.ReelTracker" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#09090D</item>
        <item name="android:statusBarColor">#09090D</item>
        <item name="android:navigationBarColor">#09090D</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
